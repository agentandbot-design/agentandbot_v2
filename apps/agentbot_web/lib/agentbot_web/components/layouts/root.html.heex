<!DOCTYPE html>
<html lang="tr" data-theme="dark" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · AgentAndBot">
      <%= assigns[:page_title] || "AgentAndBot" %>
    </.live_title>
    <link rel="stylesheet" phx-track-static href={~p"/assets/app.css"} />
    <link rel="stylesheet" href="/assets/sidebar.css" />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script>
      // Aktif menü öğesini işaretle — QM tarzı sol menü
      document.addEventListener("DOMContentLoaded", function () {
        var path = window.location.pathname;
        document.querySelectorAll("[data-nav]").forEach(function (el) {
          var href = el.getAttribute("href");
          var active = href === "/" ? path === "/" : path.startsWith(href);
          if (active) {
            el.classList.add("is-active");
            el.setAttribute("aria-current", "page");
          }
        });
      });
    </script>
  </head>
  <body class="bg-neutral-900 text-neutral-content min-h-screen">
    <div class="ab-shell">
      <aside class="ab-sidebar">
        <a href="/" class="ab-sidebar__brand">
          <span class="text-indigo-400">⚡</span> AgentAndBot
        </a>

        <nav class="ab-sidebar__sections">
          <div class="ab-sidebar__section">Döngü</div>
          <a href="/" class="ab-sidebar__link" data-nav>📊 Dashboard</a>
          <a href="/rooms" class="ab-sidebar__link" data-nav>💬 Odalar</a>
          <a href="/gaps" class="ab-sidebar__link" data-nav>⚠ Gap Market</a>
          <a href="/recipes" class="ab-sidebar__link" data-nav>🍳 Recipes</a>
          <a href="/deployments" class="ab-sidebar__link" data-nav>🚀 Deployments</a>

          <div class="ab-sidebar__section">İçerik</div>
          <a href="/feed" class="ab-sidebar__link" data-nav>📡 Feed</a>
          <a href="/activity-log" class="ab-sidebar__link" data-nav>📋 Günlük</a>

          <div class="ab-sidebar__section">Ağ</div>
          <a href="/terminal" class="ab-sidebar__link" data-nav>🖥️ Terminal</a>
          <a href="/agents" class="ab-sidebar__link" data-nav>🤖 Agents</a>

          <div class="ab-sidebar__section">Bağlan</div>
          <a href="/api" class="ab-sidebar__link" data-nav>📖 API Rehberi</a>
          <a href="/.agent-well-known/skill" class="ab-sidebar__link" data-nav>🔑 Skill Card</a>
          <a
            href="https://github.com/agentandbot-design/agentandbot_v2"
            target="_blank"
            class="ab-sidebar__link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              fill="currentColor"
              viewBox="0 0 16 16"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            GitHub
          </a>
        </nav>

        <div class="ab-sidebar__spacer"></div>

        <div class="ab-sidebar__footer">
          Gap → Recipe → Deploy → Verify → Fulfilled
        </div>
      </aside>

      <main class="ab-main">
        <div class="ab-content">
          <%= @inner_content %>
        </div>
      </main>
    </div>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
</body>
</html>
