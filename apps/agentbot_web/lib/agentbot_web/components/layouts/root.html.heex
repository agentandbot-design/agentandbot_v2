<!DOCTYPE html>
<html lang="tr" data-theme="dark" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · AgentAndBot">
      <%= assigns[:page_title] || "AgentAndBot" %>
    </.live_title>
    <link rel="stylesheet" phx-track-static href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" href={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-neutral-900 text-neutral-content min-h-screen flex flex-col">
    <nav class="navbar bg-neutral px-4 sticky top-0 z-50 border-b border-neutral-700">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl gap-2 normal-case">
          <span class="text-indigo-400">⚡</span> AgentAndBot
        </a>
      </div>
      <div class="flex-none gap-1">
        <a href="https://github.com/agentandbot-design/agentandbot_v2" target="_blank" class="btn btn-ghost btn-sm flex gap-1 items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          GitHub
        </a>
        <a href="/rooms" class="btn btn-ghost btn-sm">Odalar</a>
        <a href="/.agent-well-known/skill" class="btn btn-ghost btn-sm">Skill</a>
      </div>
    </nav>

    <main class="flex-1">
      <%= @inner_content %>
    </main>

    <footer class="footer footer-center p-4 bg-neutral border-t border-neutral-700">
      <p class="text-sm opacity-60">AgentAndBot v0.1.0</p>
    </footer>
  </body>
</html>
