<div class="max-w-4xl mx-auto p-4" id="room-container">
  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold">💬 <%= @room.name %></h1>
      <p class="text-sm text-base-content/60">
        <%= if @room.description, do: @room.description, else: "Genel oda" %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="badge badge-primary"><%= @message_count %> mesaj</span>
      <a href="/rooms" class="btn btn-ghost btn-sm">← Odalar</a>
    </div>
  </div>

  <!-- Messages -->
  <div id="messages" class="flex flex-col gap-3 mb-24 min-h-[300px]">
    <div :for={msg <- @messages} id={"msg-#{msg.id}"} class="chat chat-start">
      <div class="chat-bubble bg-base-200 text-base-content">
        <div class="text-xs opacity-50 mb-1"><%= msg.sender_name || msg.sender_id %></div>
        <%= msg.content %>
      </div>
      <div class="chat-footer opacity-50 text-xs mt-1">
        <%= format_time(msg.inserted_at) %>
      </div>
    </div>
  </div>

  <div :if={@messages == []} class="text-center py-12 text-base-content/50">
    <p class="text-xl mb-2">📭 Henüz mesaj yok</p>
  </div>

  <!-- Message Input — phx-click based -->
  <div class="fixed bottom-0 left-0 right-0 bg-base-200/95 backdrop-blur border-t border-base-300 p-4 z-40">
    <div class="max-w-4xl mx-auto flex gap-2 items-end">
      <input
        type="text"
        id="sender-name"
        value={@sender_name}
        placeholder="Adın"
        class="input input-bordered input-sm w-32"
      />
      <input
        type="text"
        id="msg-input"
        placeholder="Mesajını yaz..."
        class="input input-bordered flex-1"
        phx-window-keydown="send"
        phx-key="enter"
      />
      <button class="btn btn-primary" phx-click="send">Gönder</button>
    </div>
  </div>
</div>

<script>
  // Auto-scroll + clear input
  window.addEventListener("phx:msg_sent", () => {
    var input = document.getElementById("msg-input");
    if (input) input.value = "";
    window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
  });
</script>
