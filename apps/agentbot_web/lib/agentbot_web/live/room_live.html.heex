<div class="max-w-7xl mx-auto p-4">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold">
        💬 <%= @room.name %>
        <%= if @room_status == :paused do %>
          <span class="badge badge-warning gap-1">⏸ Duraklatıldı</span>
        <% else %>
          <span class="badge badge-success gap-1">▶ Aktif</span>
        <% end %>
      </h1>
      <p class="text-sm opacity-60">
        <%= if @room.description, do: @room.description, else: "Genel oda" %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="badge badge-primary"><%= @message_count %> mesaj</span>

      <!-- Pause / Resume -->
      <%= if @room_status == :active do %>
        <button phx-click="pause_room" class="btn btn-warning btn-sm">⏸ Duraklat</button>
      <% else %>
        <button phx-click="resume_room" class="btn btn-success btn-sm">▶ Devam</button>
      <% end %>

      <.link href={~p"/rooms"} class="btn btn-ghost btn-sm">← Odalar</.link>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-4">
    <!-- ═══ Mesaj Alanı ═══ -->
    <div>
      <!-- Messages -->
      <div id="messages" class="flex flex-col gap-2 mb-24 min-h-[400px]" phx-update="stream">
        <div :for={{dom_id, msg} <- @streams.messages} id={dom_id}>
          <%= case msg_type(msg) do %>
            <% :agent -> %>
              <!-- Agent mesajı — sağ taraf, mavi -->
              <div class="chat chat-end">
                <div class="chat-header text-xs opacity-60 mb-1">
                  🤖 <%= msg.sender_name || msg.sender_id %>
                </div>
                <div class="chat-bubble bg-primary text-primary-content">
                  <%= msg.content %>
                </div>
                <div class="chat-footer opacity-50 text-xs mt-1">
                  <%= format_time(msg.inserted_at) %>
                </div>
              </div>

            <% :system -> %>
              <!-- Sistem mesajı — ortalanmış, gri -->
              <div class="text-center py-2">
                <span class="badge badge-ghost">
                  <%= msg.content %>
                </span>
              </div>

            <% :human -> %>
              <!-- İnsan mesajı — sol taraf, nötr -->
              <div class="chat chat-start">
                <div class="chat-header text-xs opacity-60 mb-1">
                  👤 <%= msg.sender_name || msg.sender_id %>
                </div>
                <div class="chat-bubble bg-neutral-700">
                  <%= msg.content %>
                </div>
                <div class="chat-footer opacity-50 text-xs mt-1">
                  <%= format_time(msg.inserted_at) %>
                </div>
              </div>
          <% end %>
        </div>
      </div>

      <div :if={@message_count == 0} class="text-center py-12 opacity-50">
        <p class="text-xl">📭 Henüz mesaj yok</p>
      </div>
    </div>

    <!-- ═══ Sağ Sidebar ═══ -->
    <div class="space-y-4">
      <!-- Online Agents -->
      <div class="card bg-neutral-800 shadow-lg">
        <div class="card-body p-4">
          <h2 class="card-title text-sm">🤖 Çevrimiçi Agent'lar</h2>
          <div :if={@online_agents == []} class="text-sm opacity-50 py-2">
            Çevrimiçi agent yok
          </div>
          <ul class="space-y-1">
            <li :for={agent <- @online_agents} class="flex items-center gap-2 text-sm">
              <span class="inline-block w-2 h-2 rounded-full bg-success animate-pulse"></span>
              <%= agent.agent_name || agent.agent_id %>
            </li>
          </ul>
        </div>
      </div>

      <!-- Approval Panel -->
      <div class="card bg-neutral-800 shadow-lg">
        <div class="card-body p-4">
          <h2 class="card-title text-sm">
            ⚡ Onay Talepleri
            <%= if @approvals != [], do: raw("<span class='badge badge-error badge-xs'>#{length(@approvals)}</span>") %>
          </h2>
          <div :if={@approvals == []} class="text-sm opacity-50 py-2">
            Bekleyen onay yok
          </div>
          <div class="space-y-3">
            <div :for={approval <- @approvals} class="border border-neutral-700 rounded-lg p-3">
              <div class="font-semibold text-sm"><%= approval.title %></div>
              <div :if={approval.description} class="text-xs opacity-60 mt-1">
                <%= approval.description %>
              </div>
              <div class="text-xs opacity-50 mt-1">
                İsteyen: <%= approval.requester_name || approval.requester_id %>
              </div>
              <div class="flex gap-2 mt-2">
                <button phx-click="approve" phx-value-id={approval.id} class="btn btn-success btn-xs">
                  ✅ Onayla
                </button>
                <button phx-click="reject" phx-value-id={approval.id} class="btn btn-error btn-xs">
                  ❌ Reddet
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Input — sticky bottom -->
<div class="fixed bottom-0 left-0 right-0 bg-neutral-800 border-t border-neutral-700 p-4 z-40">
  <div class="max-w-7xl mx-auto">
    <.form for={@form} phx-submit="send_message" class="flex gap-2">
      <input type="text" name="sender_name" value={@sender_name} class="input input-bordered input-sm w-28" />
      <input type="text" name="content" placeholder="Mesajını yaz..." class="input input-bordered flex-1" required autocomplete="off" />
      <button type="submit" class="btn btn-primary">Gönder</button>
    </.form>
  </div>
</div>
