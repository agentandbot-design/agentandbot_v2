<div class="max-w-4xl mx-auto p-4">
  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold">💬 <%= @room.name %></h1>
      <p class="text-sm text-base-content/60">
        <%= if @room.description, do: @room.description, else: "Genel oda" %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="badge badge-primary"><%= @message_count %> mesaj</span>
      <a href="/rooms" class="btn btn-ghost btn-sm">← Odalar</a>
    </div>
  </div>

  <!-- Message Input -->
  <div class="card bg-base-200 shadow-lg mb-4 sticky bottom-4">
    <div class="card-body p-4">
      <.form for={@form} phx-submit="send_message" class="flex gap-2 items-end">
        <div class="flex-1">
          <input
            type="text"
            name="sender_name"
            value={@form[:sender_name].value}
            placeholder="Adın"
            class="input input-bordered input-sm w-32"
          />
        </div>
        <div class="flex-[3]">
          <input
            type="text"
            name="content"
            value={@form[:content].value}
            placeholder="Mesajını yaz..."
            class="input input-bordered w-full"
            required
            autocomplete="off"
          />
        </div>
        <button type="submit" class="btn btn-primary">Gönder</button>
      </.form>
    </div>
  </div>

  <!-- Messages -->
  <div id="messages" class="flex flex-col gap-2 mb-4">
    <div :for={msg <- @messages} id={"msg-#{msg.id}"} class="chat chat-start">
      <div class="chat-bubble bg-base-200 text-base-content">
        <div class="text-xs opacity-50 mb-1"><%= msg.sender_name || msg.sender_id %></div>
        <%= msg.content %>
      </div>
      <div class="chat-footer opacity-50 text-xs mt-1">
        <%= format_time(msg.inserted_at) %>
      </div>
    </div>
  </div>

  <div :if={@messages == []} class="text-center py-12 text-base-content/50">
    <p class="text-xl mb-2">📭 Henüz mesaj yok</p>
    <p>İlk mesajı sen gönder!</p>
  </div>
</div>
