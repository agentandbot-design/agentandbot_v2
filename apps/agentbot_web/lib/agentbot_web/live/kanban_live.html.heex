<div class="p-4 max-w-full overflow-x-auto">
  <%!-- Header --%>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-white">📋 Kanban Board</h1>
    <div class="flex items-center gap-2 text-sm text-neutral-400">
      <span class="badge badge-neutral"><%= length(@tasks) %> tasks</span>
    </div>
  </div>

  <%!-- Filter Bar --%>
  <div class="flex flex-wrap gap-3 mb-6 p-3 bg-[#1e1e1e] rounded-xl border border-neutral-700">
    <div class="flex items-center gap-2">
      <label class="text-xs text-neutral-400 uppercase tracking-wider">Oda</label>
      <select
        phx-change="filter_room"
        name="room"
        class="select select-sm select-bordered bg-neutral-800 border-neutral-600 text-white text-sm"
      >
        <option value="all" selected={@filter_room == "all"}>Tüm Odalar</option>
        <%= for room <- @rooms do %>
          <option value={room.id} selected={to_string(@filter_room) == to_string(room.id)}>
            <%= room.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="flex items-center gap-2">
      <label class="text-xs text-neutral-400 uppercase tracking-wider">Aşama</label>
      <select
        phx-change="filter_stage"
        name="stage"
        class="select select-sm select-bordered bg-neutral-800 border-neutral-600 text-white text-sm"
      >
        <option value="all" selected={@filter_stage == "all"}>Tüm Aşamalar</option>
        <%= for stage <- @stages do %>
          <option value={stage} selected={@filter_stage == stage}>
            <%= @stage_emojis[stage] %> <%= @stage_labels[stage] %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="flex items-center gap-2">
      <label class="text-xs text-neutral-400 uppercase tracking-wider">Kişi</label>
      <select
        phx-change="filter_assignee"
        name="assignee"
        class="select select-sm select-bordered bg-neutral-800 border-neutral-600 text-white text-sm"
      >
        <option value="all" selected={@filter_assignee == "all"}>Tümü</option>
        <option value="unassigned" selected={@filter_assignee == "unassigned"}>Atanmamış</option>
        <%= for a <- @unique_assignees do %>
          <option value={a} selected={@filter_assignee == a}><%= a %></option>
        <% end %>
      </select>
    </div>

    <div class="ml-auto flex items-center gap-3 text-xs text-neutral-500">
      <%= for stage <- @stages do %>
        <span>
          <%= @stage_emojis[stage] %>
          <%= Enum.count(@tasks, fn t -> t.status == stage end) %>
        </span>
      <% end %>
    </div>
  </div>

  <%!-- Kanban per Room --%>
  <%= for room <- @rooms do %>
    <% room_tasks = Map.get(@tasks_by_room, to_string(room.id), []) %>
    <% room_tasks_filtered = if @filter_stage == "all", do: room_tasks, else: Enum.filter(room_tasks, fn t -> t.status == @filter_stage end) %>
    <% is_collapsed = Map.get(@collapsed, to_string(room.id), false) %>

    <div class="mb-6" id={"room-section-#{room.id}"}>
      <button
        phx-click="toggle_section"
        phx-value-room_id={room.id}
        class="w-full flex items-center justify-between p-3 bg-[#1e1e1e] rounded-t-xl border border-b-0 border-neutral-700 hover:bg-[#252525] transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-3">
          <span class={"text-lg transition-transform duration-200 #{if is_collapsed, do: "-rotate-90", else: "rotate-0"}"}>▼</span>
          <h2 class="text-lg font-semibold text-white"><%= room.name %></h2>
          <span class="badge badge-sm badge-neutral"><%= length(room_tasks) %> task</span>
        </div>
        <div class="flex items-center gap-2" phx-click="noop">
          <input
            type="text"
            placeholder="+ Yeni task..."
            phx-keydown="create_task"
            phx-key="Enter"
            phx-value-room_id={room.id}
            name="title"
            class="input input-sm input-bordered bg-neutral-800 border-neutral-600 text-white text-xs w-48"
          />
        </div>
      </button>

      <%= unless is_collapsed do %>
        <div class="grid grid-cols-7 gap-2 p-3 bg-[#171717] rounded-b-xl border border-t-0 border-neutral-700 overflow-x-auto">
          <%= for stage <- @stages do %>
            <% stage_tasks = Enum.filter(room_tasks_filtered, fn t -> t.status == stage end) %>
            <div
              class="min-w-[140px]"
              id={"column-#{room.id}-#{stage}"}
              phx-hook="SortableKanban"
              data-stage={stage}
              data-room-id={room.id}
            >
              <div class={"flex items-center justify-between p-2 rounded-lg mb-2 border #{column_border_class(stage)}"}>
                <span class="text-xs font-medium text-neutral-300">
                  <%= @stage_emojis[stage] %> <%= @stage_labels[stage] %>
                </span>
                <span class="text-[10px] text-neutral-500"><%= length(stage_tasks) %></span>
              </div>

              <div class="space-y-2 kanban-column min-h-[60px]" id={"cards-#{room.id}-#{stage}"}>
                <%= for task <- stage_tasks do %>
                  <div
                    class={"kanban-card p-2 rounded-lg border cursor-grab active:cursor-grabbing hover:border-neutral-500 transition-all #{card_border_class(task.status)}"}
                    draggable="true"
                    data-task-id={task.id}
                    id={"task-#{task.id}"}
                  >
                    <div class="flex items-start justify-between gap-1">
                      <p class="text-xs text-white leading-tight line-clamp-2 flex-1"><%= task.title %></p>
                      <%= if task.priority > 0 do %>
                        <span class={"text-[10px] font-bold #{priority_color(task.priority)}"}>P<%= task.priority %></span>
                      <% end %>
                    </div>
                    <div class="flex items-center justify-between mt-1.5">
                      <span class="text-[10px] text-neutral-500"><%= relative_time(task.updated_at || task.inserted_at) %></span>
                      <%= if task.assigned_to && task.assigned_to != "" do %>
                        <span class="text-[10px] text-neutral-400 bg-neutral-800 px-1.5 py-0.5 rounded"><%= task.assigned_to %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= if @rooms == [] do %>
    <div class="text-center py-20 text-neutral-500">
      <p class="text-4xl mb-4">📋</p>
      <p class="text-lg">Henüz oda yok</p>
    </div>
  <% end %>
</div>
