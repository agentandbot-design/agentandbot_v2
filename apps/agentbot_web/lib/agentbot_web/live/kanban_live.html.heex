<div class="ab-content max-w-full px-4 sm:px-6">
  <!-- Başlık & Üst Çubuk -->
  <div class="ab-page-head flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold flex items-center gap-2">
        <span>📋</span> AgentAndBot Kanban Board
      </h1>
      <p class="text-neutral-400 text-sm mt-1">
        Tüm operasyonel görevlerin, problemlerin ve açık noktaların merkezi takip panosu.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button
        phx-click="open_new_modal"
        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm font-semibold flex items-center gap-2 shadow-lg shadow-indigo-600/20 transition cursor-pointer"
      >
        <span>➕</span> Yeni Kart / Problem Ekle
      </button>
    </div>
  </div>

  <!-- Metrik Kartları -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-neutral-400 font-medium">Toplam İş</div>
      <div class="text-2xl font-bold text-neutral-100 mt-1"><%= @stats.total %></div>
    </div>
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-sky-400 font-medium">📥 Açık / Bekleyen</div>
      <div class="text-2xl font-bold text-sky-300 mt-1"><%= @stats.open %></div>
    </div>
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-amber-400 font-medium">⚙️ Sürüyor</div>
      <div class="text-2xl font-bold text-amber-300 mt-1"><%= @stats.in_progress %></div>
    </div>
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-purple-400 font-medium">🔍 İnceleme</div>
      <div class="text-2xl font-bold text-purple-300 mt-1"><%= @stats.review %></div>
    </div>
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-emerald-400 font-medium">✅ Tamamlandı</div>
      <div class="text-2xl font-bold text-emerald-300 mt-1"><%= @stats.completed %></div>
    </div>
    <div class="bg-neutral-800/80 border border-neutral-700/60 rounded-xl p-3">
      <div class="text-xs uppercase tracking-wider text-rose-400 font-medium">⛔ Engelli</div>
      <div class="text-2xl font-bold text-rose-300 mt-1"><%= @stats.blocked %></div>
    </div>
  </div>

  <!-- Filtre & Arama Çubuğu -->
  <div class="bg-neutral-800/60 border border-neutral-700/50 rounded-xl p-3.5 mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
      <!-- Arama -->
      <form phx-change="search" class="relative flex-1 min-w-[200px] max-w-md">
        <input
          type="text"
          name="q"
          value={@search_query}
          placeholder="Kartlarda ara (başlık, açıklama, ajan)..."
          class="w-full bg-neutral-900/80 border border-neutral-700 rounded-lg px-3 py-1.5 text-sm text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-indigo-500"
          autocomplete="off"
        />
      </form>

      <!-- Atanan Filtresi -->
      <form phx-change="filter_assignee" class="flex items-center gap-1.5">
        <span class="text-xs text-neutral-400">Atanan:</span>
        <select
          name="assignee"
          class="bg-neutral-900 border border-neutral-700 rounded-lg px-2.5 py-1.5 text-xs text-neutral-200 focus:outline-none focus:border-indigo-500"
        >
          <option value="all" selected={@filter_assignee == "all"}>Tümü</option>
          <option value="unassigned" selected={@filter_assignee == "unassigned"}>Atanmamış</option>
          <%= for {name, id} <- @assignees, id != "" do %>
            <option value={id} selected={@filter_assignee == id}><%= name %></option>
          <% end %>
        </select>
      </form>

      <!-- Capability Filtresi -->
      <form phx-change="filter_capability" class="flex items-center gap-1.5">
        <span class="text-xs text-neutral-400">Kategori:</span>
        <select
          name="capability"
          class="bg-neutral-900 border border-neutral-700 rounded-lg px-2.5 py-1.5 text-xs text-neutral-200 focus:outline-none focus:border-indigo-500"
        >
          <option value="all" selected={@filter_capability == "all"}>Tümü</option>
          <%= for {name, cap} <- @capabilities do %>
            <option value={cap} selected={@filter_capability == cap}><%= name %></option>
          <% end %>
        </select>
      </form>
    </div>

    <div class="text-xs text-neutral-500 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Canlı PubSub Senkronize
    </div>
  </div>

  <!-- KANBAN SÜTUNLARI -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 items-start">
    <%= for col <- @columns do %>
      <% tasks = Map.get(@tasks_by_column, col.id, []) %>
      <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-3 flex flex-col min-h-[450px]">
        <!-- Sütun Başlığı -->
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-neutral-800">
          <div class="flex items-center gap-2 font-semibold text-sm text-neutral-200">
            <span><%= col.icon %></span>
            <span><%= col.title %></span>
          </div>
          <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-neutral-800 text-neutral-400 border border-neutral-700">
            <%= length(tasks) %>
          </span>
        </div>

        <!-- Kartlar Listesi -->
        <div class="flex flex-col gap-3 flex-1">
          <%= if Enum.empty?(tasks) do %>
            <div class="flex-1 flex items-center justify-center border border-dashed border-neutral-800/80 rounded-lg p-4 text-center">
              <span class="text-xs text-neutral-600">Bu aşamada kart yok</span>
            </div>
          <% else %>
            <%= for task <- tasks do %>
              <% {p_label, p_class} = priority_badge(task.priority) %>
              <div class="bg-neutral-800/90 hover:bg-neutral-800 border border-neutral-700/70 hover:border-neutral-600 rounded-xl p-3.5 shadow-sm transition flex flex-col justify-between group">
                <div>
                  <!-- Kart Üst Başlığı (Badge & ID) -->
                  <div class="flex items-center justify-between gap-1 mb-2">
                    <span class={"text-[10px] font-semibold px-2 py-0.5 rounded border #{p_class}"}>
                      <%= p_label %>
                    </span>
                    <span class="text-[11px] font-mono text-neutral-400 bg-neutral-900/60 px-1.5 py-0.5 rounded">
                      #<%= task.id %>
                    </span>
                  </div>

                  <!-- Başlık -->
                  <h3 class="text-sm font-semibold text-neutral-100 leading-snug mb-1.5">
                    <%= task.title %>
                  </h3>

                  <!-- Açıklama -->
                  <%= if task.description && task.description != "" do %>
                    <p class="text-xs text-neutral-400 line-clamp-3 mb-2.5 font-normal leading-relaxed">
                      <%= task.description %>
                    </p>
                  <% end %>

                  <!-- Kategori & Atanan -->
                  <div class="flex flex-wrap items-center gap-1.5 mb-3 text-[11px]">
                    <span class="bg-indigo-950/60 text-indigo-300 border border-indigo-800/60 px-2 py-0.5 rounded-md font-mono">
                      🏷️ <%= task.capability %>
                    </span>

                    <%= if task.assigned_to && task.assigned_to != "" do %>
                      <span class="bg-neutral-900 text-neutral-300 border border-neutral-700 px-2 py-0.5 rounded-md flex items-center gap-1">
                        🤖 <%= task.assigned_to %>
                      </span>
                    <% else %>
                      <span class="bg-neutral-900/50 text-neutral-500 border border-neutral-800 px-2 py-0.5 rounded-md">
                        👤 Atanmamış
                      </span>
                    <% end %>
                  </div>

                  <!-- Artifact Durumu -->
                  <div class="text-[11px] mb-3">
                    <%= if not Enum.empty?(task.artifacts) do %>
                      <div class="bg-emerald-950/40 border border-emerald-800/60 text-emerald-300 px-2 py-1 rounded flex items-center justify-between">
                        <span>📦 <%= length(task.artifacts) %> Artifact Kayıtlı</span>
                        <span class="text-[10px] opacity-80">Doğrulandı ✓</span>
                      </div>
                    <% else %>
                      <%= if task.status == "completed" do %>
                        <div class="bg-amber-950/40 border border-amber-800/60 text-amber-400 px-2 py-1 rounded text-[10px]">
                          ⚠️ Artifactsız Tamamlanmış
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <!-- Aksiyonlar / Geçiş Butonları -->
                <div class="pt-2.5 border-t border-neutral-700/50 flex items-center justify-between gap-1 text-xs">
                  <div class="flex items-center gap-1 flex-wrap">
                    <%= if task.status != "open" do %>
                      <button
                        phx-click="move_status"
                        phx-value-id={task.id}
                        phx-value-status="open"
                        title="Açık / Backlog'a taşı"
                        class="p-1 text-neutral-400 hover:text-sky-300 hover:bg-neutral-700 rounded transition"
                      >
                        📥
                      </button>
                    <% end %>

                    <%= if task.status != "in_progress" do %>
                      <button
                        phx-click="move_status"
                        phx-value-id={task.id}
                        phx-value-status="in_progress"
                        title="Sürüyor (In Progress) yap"
                        class="p-1 text-neutral-400 hover:text-amber-300 hover:bg-neutral-700 rounded transition"
                      >
                        ⚙️
                      </button>
                    <% end %>

                    <%= if task.status != "review" do %>
                      <button
                        phx-click="move_status"
                        phx-value-id={task.id}
                        phx-value-status="review"
                        title="İnceleme (Review) aşamasına al"
                        class="p-1 text-neutral-400 hover:text-purple-300 hover:bg-neutral-700 rounded transition"
                      >
                        🔍
                      </button>
                    <% end %>

                    <%= if task.status != "completed" do %>
                      <button
                        phx-click="open_artifact_modal"
                        phx-value-id={task.id}
                        title="Artifact ekle ve tamamla"
                        class="p-1 text-neutral-400 hover:text-emerald-300 hover:bg-neutral-700 rounded transition"
                      >
                        ✅
                      </button>
                    <% end %>

                    <%= if task.status != "blocked" do %>
                      <button
                        phx-click="move_status"
                        phx-value-id={task.id}
                        phx-value-status="blocked"
                        title="Engellendi / İptal olarak işaretle"
                        class="p-1 text-neutral-400 hover:text-rose-400 hover:bg-neutral-700 rounded transition"
                      >
                        ⛔
                      </button>
                    <% end %>
                  </div>

                  <button
                    phx-click="delete_task"
                    phx-value-id={task.id}
                    data-confirm="Bu kartı silmek istediğinize emin misiniz?"
                    title="Kartı Sil"
                    class="p-1 text-neutral-500 hover:text-rose-400 hover:bg-neutral-700 rounded transition"
                  >
                    🗑️
                  </button>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- YENİ KART EKLEME MODALI -->
  <%= if @show_modal do %>
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="bg-neutral-900 border border-neutral-700 rounded-2xl max-w-lg w-full p-6 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-neutral-800">
          <h2 class="text-lg font-bold text-neutral-100 flex items-center gap-2">
            <span>➕</span> Yeni Kart / Görev Ekle
          </h2>
          <button
            phx-click="close_modal"
            class="text-neutral-400 hover:text-neutral-200 text-lg p-1"
          >
            ✕
          </button>
        </div>

        <form phx-submit="save_task" class="flex flex-col gap-4">
          <div>
            <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
              Kart Başlığı *
            </label>
            <input
              type="text"
              name="task[title]"
              value={@new_task["title"]}
              required
              placeholder="Örn: Sahte-complete bug fix veya News feed entegrasyonu"
              class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-3 py-2 text-sm text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
              Açıklama / Problem Detayı
            </label>
            <textarea
              name="task[description]"
              rows="3"
              placeholder="Problemin kök nedeni, hedefler ve teslim edilmesi gereken artifact formatı..."
              class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-3 py-2 text-sm text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-indigo-500"
            ><%= @new_task["description"] %></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
                Kategori
              </label>
              <select
                name="task[capability]"
                class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-2.5 py-2 text-xs text-neutral-100 focus:outline-none focus:border-indigo-500"
              >
                <%= for {name, cap} <- @capabilities do %>
                  <option value={cap} selected={@new_task["capability"] == cap}><%= name %></option>
                <% end %>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
                Öncelik
              </label>
              <select
                name="task[priority]"
                class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-2.5 py-2 text-xs text-neutral-100 focus:outline-none focus:border-indigo-500"
              >
                <option value="2">P0 Acil</option>
                <option value="1" selected>P1 Yüksek</option>
                <option value="0">P2 Normal</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
                Atanan Ajan / İnsan
              </label>
              <select
                name="task[assigned_to]"
                class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-2.5 py-2 text-xs text-neutral-100 focus:outline-none focus:border-indigo-500"
              >
                <%= for {name, id} <- @assignees do %>
                  <option value={id} selected={@new_task["assigned_to"] == id}><%= name %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-800 mt-2">
            <button
              type="button"
              phx-click="close_modal"
              class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg text-sm transition"
            >
              Vazgeç
            </button>
            <button
              type="submit"
              class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-lg text-sm transition shadow-lg shadow-indigo-600/30"
            >
              Kartı Kaydet
            </button>
          </div>
        </form>
      </div>
    </div>
  <% end %>

  <!-- ARTIFACT & TAMAMLAMA MODALI -->
  <%= if @show_artifact_modal do %>
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="bg-neutral-900 border border-neutral-700 rounded-2xl max-w-lg w-full p-6 shadow-2xl">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-neutral-800">
          <h2 class="text-lg font-bold text-emerald-400 flex items-center gap-2">
            <span>📦</span> Artifact Teslim Et & Tamamla
          </h2>
          <button
            phx-click="close_modal"
            class="text-neutral-400 hover:text-neutral-200 text-lg p-1"
          >
            ✕
          </button>
        </div>

        <p class="text-xs text-neutral-400 mb-4">
          <em>"Conversation is temporary, Artifact is the product."</em> — Bu görevin tamamlanması için teslim edilen çıktıyı (rapor, kod, diff, karar) kaydedin.
        </p>

        <form phx-submit="submit_artifact_and_complete" class="flex flex-col gap-4">
          <input type="hidden" name="task_id" value={@show_artifact_modal} />

          <div>
            <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
              Artifact Başlığı
            </label>
            <input
              type="text"
              name="artifact[title]"
              placeholder="Örn: Bug Fix & Guard Uygulama Raporu"
              class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-3 py-2 text-sm text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-emerald-500"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
                Artifact Tipi
              </label>
              <select
                name="artifact[artifact_type]"
                class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-2.5 py-2 text-xs text-neutral-100 focus:outline-none focus:border-emerald-500"
              >
                <option value="code">Kod & Modül (Code)</option>
                <option value="report" selected>Rapor (Report)</option>
                <option value="diff">Git Patch / Diff</option>
                <option value="decision">Karar Kaydı (Decision)</option>
                <option value="data">Veri / Çıktı (Data)</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1.5">
              Teslimat Çıktısı / Kod / Açıklama *
            </label>
            <textarea
              name="artifact[content]"
              rows="4"
              required
              placeholder="Yapılan değişiklikler, test kanıtları veya üretilen kodun detayları..."
              class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-3 py-2 text-sm text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-emerald-500 font-mono text-xs"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-neutral-800 mt-2">
            <button
              type="button"
              phx-click="move_status"
              phx-value-id={@show_artifact_modal}
              phx-value-status="completed"
              phx-value-force="true"
              class="text-xs text-neutral-500 hover:text-amber-400 underline"
            >
              Artifactsız Zorla Tamamla (İstisna)
            </button>

            <div class="flex items-center gap-2">
              <button
                type="button"
                phx-click="close_modal"
                class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg text-xs transition"
              >
                Vazgeç
              </button>
              <button
                type="submit"
                class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg text-sm transition shadow-lg shadow-emerald-600/30"
              >
                Teslim Et ve Tamamla ✓
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  <% end %>
</div>
